<Project>
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>11.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);CS9057</NoWarn>

    <!-- Ensure Dev configuration exists solution-wide -->
    <Configurations>Debug;Release;Dev</Configurations>
  </PropertyGroup>

  <!-- Dev = Release-like optimizations + symbols + global dev define -->
  <PropertyGroup Condition="'$(Configuration)'=='Dev'">
    <Optimize>true</Optimize>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>portable</DebugType>
    <DefineConstants>$(DefineConstants);MIKE_DEV</DefineConstants>
  </PropertyGroup>

  <!-- Local fallback for Linux dev environment when GamePath isn't provided explicitly. -->
  <PropertyGroup Condition="'$(GamePath)'=='' and Exists('/media/mike/HomeII/Games/gog/stardew-valley/game/StardewValley.dll')">
    <GamePath>/media/mike/HomeII/Games/gog/stardew-valley/game</GamePath>
  </PropertyGroup>
</Project>
