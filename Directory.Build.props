<Project>
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>11.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);CS9057</NoWarn>
    <Configurations>Debug;Release;Dev</Configurations>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Dev'">
    <Optimize>true</Optimize>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>portable</DebugType>
    <DefineConstants>$(DefineConstants);MIKE_DEV</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(GamePath)'=='' and Exists('/media/mike/HomeII/Games/gog/stardew-valley/game/StardewValley.dll')">
  </PropertyGroup>
  <PropertyGroup>
    <_StardewHome Condition="'$(HOME)' != ''">$(HOME)/stardew/game</_StardewHome>
    <GamePath Condition="'$(GamePath)' == ''         and '$(_StardewHome)' != ''         and Exists('$(_StardewHome)')">$(_StardewHome)</GamePath>
    <GamePath Condition="'$(GamePath)' == ''         and '$(OS)' == 'Windows_NT'         and Exists('C:\Users\Mike\Documents\Stardew Valley')">C:\Users\Mike\Documents\Stardew Valley</GamePath>
  </PropertyGroup>
  <PropertyGroup>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
  </PropertyGroup>
</Project>