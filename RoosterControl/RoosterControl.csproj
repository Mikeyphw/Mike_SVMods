<?xml version='1.0' encoding='utf-8'?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <!-- Dev config only: enables RCTRL_DEV (no Debug build define). -->
  <PropertyGroup Condition="'$(Configuration)'=='Dev'">
    <DefineConstants>$(DefineConstants);RCTRL_DEV</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.4.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)'!='Dev'">
    <!-- Non-Dev builds embed JSON into generated code and do not ship data/*.json on disk. -->
    <MikeEmbedText Include="data/**/*.json" />
    <None Remove="data/**/*.json" />
    <Content Remove="data/**/*.json" />
  </ItemGroup>

  <ItemGroup>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\NestCore\NestCore.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="GMCMenu.cs" />
    <Compile Remove="Framework/ModConfig.cs" />
      <Compile Remove="Application/RoosterCoordinator.FertilizedEggs.cs" />
  </ItemGroup>
</Project>
