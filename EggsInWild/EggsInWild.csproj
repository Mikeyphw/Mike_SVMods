<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>EggsInWild</AssemblyName>
    <RootNamespace>EggsInWild</RootNamespace>
  </PropertyGroup>

  <!-- Dev config only: enables WEGG_DEV (no Debug build define). -->
  <PropertyGroup Condition="'$(Configuration)'=='Dev'">
    <DefineConstants>$(DefineConstants);WEGG_DEV</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Constants.cs" />
    <Compile Include="ModEntry.cs" />
    <Compile Include="ModEntry.*.cs" />
    <Compile Include="Application/**/*.cs" />
    <Compile Include="Core/**/*.cs" />
    <Compile Include="Infrastructure/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="i18n/**/*" CopyToOutputDirectory="PreserveNewest" />

    <!-- Dev: JSON on disk (source of truth). -->
    <None Include="ModData/**/*" CopyToOutputDirectory="PreserveNewest" Condition="'$(Configuration)'=='Dev'" />
    <None Include="assets/**/*" CopyToOutputDirectory="PreserveNewest" Condition="'$(Configuration)'=='Dev'" />

    <!-- Non-Dev: ship non-JSON assets only (JSON is embedded). -->
    <None Include="assets/**/*" CopyToOutputDirectory="PreserveNewest" Condition="'$(Configuration)'!='Dev'" />
    <None Remove="assets/**/*.json" Condition="'$(Configuration)'!='Dev'" />
  </ItemGroup>

  <!-- Non-Dev: embed mod JSON as generated code; do not ship it. -->
  <ItemGroup Condition="'$(Configuration)'!='Dev'">
    <MikeEmbedText Include="ModData/**/*.json" />
    <MikeEmbedText Include="assets/**/*.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.4.0" />
    <PackageReference Include="Lib.Harmony" Version="2.3.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NestCore\NestCore.csproj" Private="false" />
  </ItemGroup>

</Project>
