HEADER_RE = re.compile(
    r"^\[(?P<time>\d\d:\d\d:\d\d)\s+(?P<level>TRACE|DEBUG|INFO|WARN|ERROR|ALERT)\s+(?P<source>[^\]]+)\]\s?(?P<msg>.*)$"
)
SCOPED_RE = re.compile(r"^\[(?P<tag>[^\]]+)\]\[(?P<category>[^\]]+)\]\[(?P<token>[^\]]+)\]\s*(?P<rest>.*)$")
LOAD_MOD_RE = re.compile(r"^\s*(?P<name>.+?)\s+\(from .+?,\s+ID:\s+(?P<uid>[^,\)]+)")
LOADED_MOD_LINE_RE = re.compile(r"^\s*(?P<name>.+?)\s+\S+\s+by\s+(?P<author>.+?)\s+\|")

