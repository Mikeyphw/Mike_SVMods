# Parsing / sessions
# -----------------------------


def parse_entries(lines: Sequence[str], *, file_label: str) -> List[SmapiEntry]:
    entries: List[SmapiEntry] = []
    current: Optional[SmapiEntry] = None

    def flush() -> None:
        nonlocal current
        if current is None:
            return
        if current.lines:
            m = SCOPED_RE.match(current.lines[0])
            if m:
                current.scoped = ScopedInfo(
                    tag=m.group("tag"),
                    category=m.group("category"),
                    token=m.group("token"),
                    message=(m.group("rest") + ("\n" + "\n".join(current.lines[1:]) if len(current.lines) > 1 else "")).rstrip(
                        "\n"
                    ),
                )
        entries.append(current)
        current = None

    idx = 0
    for raw in lines:
        raw = raw.rstrip("\n")
        m = HEADER_RE.match(raw)
        if m:
            flush()
            idx += 1
            current = SmapiEntry(
                index=idx,
                time=m.group("time"),
                level=m.group("level"),
                source=m.group("source").strip(),
                lines=[m.group("msg")] if m.group("msg") else [],
                file=file_label,
            )
            continue

        if current is None:
            idx += 1
            current = SmapiEntry(index=idx, time="??:??:??", level="INFO", source="(preamble)", lines=[raw], file=file_label)
        else:
            current.lines.append(raw)

    flush()
    return entries


def is_session_start(entry: SmapiEntry) -> bool:
    if entry.source.strip() != "SMAPI":
        return False
    msg0 = entry.lines[0] if entry.lines else ""
    hay = msg0.lower()
    for hint in SESSION_START_HINTS:
        if hint.lower() in hay:
            return True
    return False


def assign_sessions(entries: List[SmapiEntry]) -> List[List[SmapiEntry]]:
    sessions: List[List[SmapiEntry]] = []
    current: List[SmapiEntry] = []
    session_id = 1

    for e in entries:
        if current and is_session_start(e):
            sessions.append(current)
            current = []
            session_id += 1
        e.session = session_id
        current.append(e)

    if current:
        sessions.append(current)
    return sessions


def select_sessions(sessions: List[List[SmapiEntry]], selector: str) -> List[SmapiEntry]:
    if not sessions:
        return []
    s = selector.strip().lower()
    if s == "all":
        return [e for sess in sessions for e in sess]
    if s == "last":
        return list(sessions[-1])
    if s.isdigit():
        n = int(s)
        if 1 <= n <= len(sessions):
            return list(sessions[n - 1])
        return []
    if s.startswith("last"):
        # last2, last3...
        m = re.match(r"last(\d+)$", s)
        if m:
            k = int(m.group(1))
            return [e for sess in sessions[-k:] for e in sess]
    return [e for sess in sessions for e in sess]


# -----------------------------
# Mod discovery / tokens
# -----------------------------


def discover_mods_from_lines(lines: Sequence[str]) -> Tuple[Dict[str, str], Dict[str, str]]:
    mod_name_to_uid: Dict[str, str] = {}
    uid_to_mod_name: Dict[str, str] = {}
    for line in lines:
        m = HEADER_RE.match(line.rstrip("\n"))
        if not m:
            continue
        if m.group("source").strip() != "SMAPI":
            continue
        msg = m.group("msg")
        if not msg.startswith("   "):
            continue
        mm = LOAD_MOD_RE.match(msg)
        if mm:
            name = mm.group("name").strip().rstrip(".")
            uid = mm.group("uid").strip().rstrip(".")
            mod_name_to_uid[name] = uid
            uid_to_mod_name[uid] = name
    return mod_name_to_uid, uid_to_mod_name


def discover_my_mods(
    lines: Sequence[str],
    *,
    my_ids_cli: Sequence[str],
    my_names_cli: Sequence[str],
    my_prefixes: Sequence[str],
) -> Tuple[Set[str], Set[str]]:
    mod_name_to_uid, uid_to_mod_name = discover_mods_from_lines(lines)

    my_ids: Set[str] = set(KNOWN_MY_IDS) | set(my_ids_cli)
    my_names: Set[str] = set(KNOWN_MY_NAMES) | set(my_names_cli)

    for name, uid in mod_name_to_uid.items():
        if any(uid.startswith(p) for p in my_prefixes):
            my_ids.add(uid)
            my_names.add(name)

    for line in lines:
        m = HEADER_RE.match(line.rstrip("\n"))
        if not m:
            continue
        if m.group("source").strip() != "SMAPI" or m.group("level") != "INFO":
            continue
        msg = m.group("msg").strip()
        mm = LOADED_MOD_LINE_RE.match(msg)
        if mm and ("mikew" in mm.group("author").lower() or "mike" in mm.group("author").lower()):
            name = mm.group("name").strip()
            my_names.add(name)
            uid = mod_name_to_uid.get(name)
            if uid:
                my_ids.add(uid)

    for uid in list(my_ids):
        name = uid_to_mod_name.get(uid)
        if name:
            my_names.add(name)

    return my_ids, my_names


def build_match_tokens(my_ids: Set[str], my_names: Set[str], extra_tokens: Optional[Iterable[str]] = None) -> Set[str]:
    tokens: Set[str] = set()

    def add(s: str) -> None:
        s = (s or "").strip()
        if s:
            tokens.add(s)

    for uid in my_ids:
        add(uid)
        if "." in uid:
            add(uid.split(".")[-1])

    for name in my_names:
        add(name)
        add(name.replace(" ", ""))
        add(name.replace(" ", "_"))

    for ns in KNOWN_MY_NAMESPACES:
        add(ns)

    for tag in KNOWN_SCOPED_TAGS:
        add(f"[{tag}]")
        add(tag)

    add("Mikew.")
    if extra_tokens:
        for t in extra_tokens:
            add(t)

    return tokens


def compile_token_patterns(tokens: Set[str], mention_mode: str) -> List[re.Pattern]:
    patterns: List[re.Pattern] = []
    strict = mention_mode.lower() == "strict"
    for tok in sorted(tokens, key=len, reverse=True):
        esc = re.escape(tok)
        if not strict:
            patterns.append(re.compile(esc, re.IGNORECASE))
            continue

        # strict-ish boundaries for mostly word-like tokens
        if re.match(r"^[A-Za-z0-9_]+$", tok):
            patterns.append(re.compile(rf"(?<!\w){esc}(?!\w)", re.IGNORECASE))
        elif re.match(r"^[A-Za-z0-9_.]+$", tok):
            patterns.append(re.compile(rf"(?<![A-Za-z0-9_]){esc}(?![A-Za-z0-9_])", re.IGNORECASE))
        else:
            patterns.append(re.compile(esc, re.IGNORECASE))
    return patterns


# -----------------------------
# ScopedLogCatalog awareness (optional)
# -----------------------------


def try_load_scoped_catalog(repo_root: Path, explicit: Optional[Path] = None) -> Optional[CatalogInfo]:
    cand = explicit
    if cand is None:
        cand = repo_root / "NestCore" / "Helpers" / "Logging" / "ScopedLogCatalog.cs"
    if not cand.exists():
        return None

    text = cand.read_text(encoding="utf-8", errors="replace")

    tags = set(KNOWN_SCOPED_TAGS)
    categories: Set[str] = set()

    # capture enums: public enum ModWeCategory { General, ... }
    for m in re.finditer(r"enum\s+(?P<name>\w+)\s*\{(?P<body>[^}]+)\}", text, flags=re.DOTALL):
        body = m.group("body")
        for item in re.split(r"[,\s]+", body):
            item = item.strip()
            if not item or item.startswith("//"):
                continue
            if re.match(r"^[A-Za-z_]\w*$", item):
                categories.add(item)

    # capture const strings: public const string General = "general";
    for m in re.finditer(r"const\s+string\s+(?P<name>\w+)\s*=\s*\"(?P<val>[^\"]+)\"", text):
        categories.add(m.group("val"))
        categories.add(m.group("name"))

    return CatalogInfo(tags=tags, categories=categories)


# -----------------------------
# Filtering
# -----------------------------


def parse_hms(s: Optional[str]) -> Optional[int]:
    if not s:
        return None
    m = re.match(r"^(\d\d):(\d\d):(\d\d)$", s.strip())
    if not m:
        raise ValueError(f"Invalid time: {s} (expected HH:MM:SS)")
    hh, mm, ss = int(m.group(1)), int(m.group(2)), int(m.group(3))
    return hh * 3600 + mm * 60 + ss


def entry_time_seconds(entry: SmapiEntry) -> Optional[int]:
    try:
        return parse_hms(entry.time)
    except Exception:
        return None


def contains_my_mention(entry: SmapiEntry, state: RuntimeState) -> bool:
    hay = entry.full_text()
    for pat in state.token_patterns:
        if pat.search(hay):
            return True
    return False


def matches_base_rules(entry: SmapiEntry, state: RuntimeState) -> bool:
    if entry.source.strip().lower() == "game" and entry.level == "ERROR":
        return True
    if entry.source in state.my_names:
        return True
    if entry.scoped and entry.scoped.tag in KNOWN_SCOPED_TAGS:
        return True
    return contains_my_mention(entry, state)


def matches_filters(entry: SmapiEntry, f: FilterConfig, state: RuntimeState) -> bool:
    if f.levels_include and entry.level not in f.levels_include:
        return False
    if f.levels_exclude and entry.level in f.levels_exclude:
        return False

    if f.sources_include and entry.source not in f.sources_include:
        return False
    if f.sources_exclude and entry.source in f.sources_exclude:
        return False

    if f.tags_include:
        if not entry.scoped or entry.scoped.tag not in f.tags_include:
            return False

    if f.categories_include:
        if not entry.scoped:
            return False
        cat = entry.scoped.category
        if cat not in f.categories_include and cat.lower() not in {c.lower() for c in f.categories_include}:
            return False

    if f.since or f.until:
        t = entry_time_seconds(entry)
        if t is not None:
            since = parse_hms(f.since) if f.since else None
            until = parse_hms(f.until) if f.until else None
            if since is not None and t < since:
                return False
            if until is not None and t > until:
                return False

    if f.regex and not f.regex.search(entry.full_text()):
        return False
    if f.not_regex and f.not_regex.search(entry.full_text()):
        return False

    if f.grep and f.grep.lower() not in entry.full_text_lower():
        return False

    if state.catalog and entry.scoped:
        if entry.scoped.tag not in state.catalog.tags:
            return False
        if state.catalog.categories and entry.scoped.category not in state.catalog.categories and entry.scoped.category.lower() not in {
            c.lower() for c in state.catalog.categories
        }:
            # don't hard fail; only filter when categories_include is set
            pass

    return True


def should_include(entry: SmapiEntry, state: RuntimeState, f: FilterConfig) -> bool:
    if not matches_base_rules(entry, state):
        return False
    return matches_filters(entry, f, state)


# -----------------------------
# Signatures / clustering / dedupe
# -----------------------------


def classify_game_error(entry: SmapiEntry) -> Optional[str]:
    if entry.source.strip().lower() != "game" or entry.level != "ERROR":
        return None
    text = entry.message()
    for label, pat in GAME_ERROR_PATTERNS:
        if re.search(pat, text, flags=re.IGNORECASE):
            return label
    return "GameError"


def extract_exception_signature(entry: SmapiEntry) -> Optional[str]:
    msg = entry.message()
    lines = msg.splitlines()
    exc_line = None
    for ln in lines:
        if "exception" in ln.lower() or "error" in ln.lower():
            exc_line = ln.strip()
            break
    frames = [ln.strip() for ln in lines if ln.lstrip().startswith("at ")][:4]
    if exc_line or frames:
        base = exc_line or ""
        return " | ".join([base] + frames).strip()
    return None


def normalize_message_signature(entry: SmapiEntry) -> str:
    first = entry.message().splitlines()[0] if entry.lines else ""
    first = re.sub(r"\b\d+\b", "N", first)
    first = re.sub(r"\b0x[0-9a-fA-F]+\b", "0xHEX", first)
    return first.strip()


def signature(entry: SmapiEntry, cluster_by: str) -> str:
    if cluster_by == "message":
        return normalize_message_signature(entry)
    sig = extract_exception_signature(entry)
    return sig or normalize_message_signature(entry)


