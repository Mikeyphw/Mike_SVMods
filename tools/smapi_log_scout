    if args.with_crash or deep_get(cfg, ["general", "with_crash"], False):
        if DEFAULT_CRASH_PATH.exists():
            extra_logs.append(DEFAULT_CRASH_PATH)

    session_selector = args.session or deep_get(cfg, ["general", "session"], "all")

    my_prefixes = args.my_prefix or deep_get(cfg, ["my", "prefixes"], ["Mikew."])
    my_ids_cli = (deep_get(cfg, ["my", "ids"], []) or []) + args.my_id
    my_names_cli = (deep_get(cfg, ["my", "names"], []) or []) + args.my_name

    mention_mode = args.mention_mode or deep_get(cfg, ["filters", "mention_mode"], "loose")

    fcfg = FilterConfig(
        mention_mode=mention_mode,
        since=args.since or deep_get(cfg, ["filters", "since"], None),
        until=args.until or deep_get(cfg, ["filters", "until"], None),
        grep=args.grep or deep_get(cfg, ["filters", "grep"], None),
    )

    # levels include/exclude
    def _parse_levels(s: Optional[str]) -> Optional[Set[str]]:
        if not s:
            return None
        parts = [p.strip().upper() for p in s.split(",") if p.strip()]
        mapped = set()
        for p in parts:
            p2 = p.upper()
            if p2 == "WARNING":
                p2 = "WARN"
            if p2 not in LEVEL_ORDER:
                raise SystemExit(f"Unknown level: {p}")
            mapped.add(p2)
        return mapped or None

    lvl_inc = args.level or deep_get(cfg, ["filters", "levels_include"], None)
    lvl_exc = args.exclude_level or deep_get(cfg, ["filters", "levels_exclude"], None)
    if isinstance(lvl_inc, list):
        lvl_inc = ",".join(str(x) for x in lvl_inc)
    if isinstance(lvl_exc, list):
        lvl_exc = ",".join(str(x) for x in lvl_exc)
    fcfg.levels_include = _parse_levels(lvl_inc)
    fcfg.levels_exclude = _parse_levels(lvl_exc)

    # sources include/exclude
    def _parse_csv_set(s: Optional[str]) -> Optional[Set[str]]:
        if not s:
            return None
        return {p.strip() for p in str(s).split(",") if p.strip()} or None

    src_inc = args.source or deep_get(cfg, ["filters", "sources_include"], None)
    src_exc = args.exclude_source or deep_get(cfg, ["filters", "sources_exclude"], None)
    if isinstance(src_inc, list):
        src_inc = ",".join(str(x) for x in src_inc)
    if isinstance(src_exc, list):
        src_exc = ",".join(str(x) for x in src_exc)
    fcfg.sources_include = _parse_csv_set(src_inc)
    fcfg.sources_exclude = _parse_csv_set(src_exc)

    # scoped tag/category include
    tag_inc = args.tag or deep_get(cfg, ["filters", "tags_include"], None)
    cat_inc = args.category or deep_get(cfg, ["filters", "categories_include"], None)
    if isinstance(tag_inc, list):
        tag_inc = ",".join(str(x) for x in tag_inc)
    if isinstance(cat_inc, list):
        cat_inc = ",".join(str(x) for x in cat_inc)
    fcfg.tags_include = _parse_csv_set(tag_inc)
    fcfg.categories_include = _parse_csv_set(cat_inc)

    # regex / not-regex
    rx = args.regex or deep_get(cfg, ["filters", "regex"], None)
    nrx = args.not_regex or deep_get(cfg, ["filters", "not_regex"], None)
    if rx:
        fcfg.regex = re.compile(str(rx), re.IGNORECASE | re.MULTILINE)
    if nrx:
        fcfg.not_regex = re.compile(str(nrx), re.IGNORECASE | re.MULTILINE)

    out_cfg = OutputConfig(
        plain=bool(args.plain or deep_get(cfg, ["ui", "plain"], False)),
        show_index=not bool(args.no_index or deep_get(cfg, ["ui", "no_index"], False)),
        max_print=args.max if args.max is not None else int(deep_get(cfg, ["ui", "max"], 400)),
        summary_only=bool(args.summary or deep_get(cfg, ["ui", "summary_only"], False)),
        context=args.context if args.context is not None else int(deep_get(cfg, ["ui", "context"], 0)),
        dedupe=args.dedupe if args.dedupe is not None else int(deep_get(cfg, ["ui", "dedupe"], 0)),
        cluster=bool(args.cluster or deep_get(cfg, ["ui", "cluster"], False)),
        cluster_by=args.cluster_by or deep_get(cfg, ["ui", "cluster_by"], "exception"),
        occurrence=args.occurrence or deep_get(cfg, ["ui", "occurrence"], "all"),
        export_html=args.export_html or (Path(deep_get(cfg, ["export", "html"], "")).expanduser() if deep_get(cfg, ["export", "html"], "") else None),
        top=(deep_get(cfg, ["ui", "top"], []) or []) + (args.top or []),
    )

    stream_cfg = StreamConfig(
        follow=bool(args.follow or args.live),
        live=bool(args.live),
        interactive=bool(args.interactive or deep_get(cfg, ["ui", "interactive"], False)),
        from_start=bool(args.from_start or deep_get(cfg, ["stream", "from_start"], False)),
        window=args.window if args.window is not None else int(deep_get(cfg, ["ui", "window"], 60)),
        watch_mods=not bool(args.no_watch_mods or deep_get(cfg, ["stream", "no_watch_mods"], False)),
    )

    notify_mode = args.notify or deep_get(cfg, ["notify", "mode"], "none")
    notify_levels_raw = deep_get(cfg, ["notify", "levels"], ["ERROR", "ALERT"])
    notify_levels = {str(x).upper() for x in notify_levels_raw} if notify_levels_raw else {"ERROR", "ALERT"}
    ncfg = NotifyConfig(mode=str(notify_mode), levels=notify_levels)

    # catalog awareness
    repo_root = Path.cwd()
    catalog = try_load_scoped_catalog(repo_root, explicit=args.catalog)

    # ---- non-stream path ----
    all_paths = [log_path] + extra_logs
    all_labels = [p.name for p in all_paths]

    if not stream_cfg.follow:
        all_entries: List[SmapiEntry] = []
        # baseline discovery from primary log only (fast + stable)
        base_lines = read_file_lines(log_path, read_last_bytes=args.read_last_bytes)
        my_ids, my_names = discover_my_mods(base_lines, my_ids_cli=my_ids_cli, my_names_cli=my_names_cli, my_prefixes=my_prefixes)
        tokens = build_match_tokens(my_ids, my_names)
        state = RuntimeState(my_ids=my_ids, my_names=my_names, tokens=tokens, token_patterns=compile_token_patterns(tokens, mention_mode), catalog=catalog)

        # parse sessions per file and merge (keeps per-file session numbering independent)
        for p, lbl in zip(all_paths, all_labels):
            lines = read_file_lines(p, read_last_bytes=args.read_last_bytes)
            entries = parse_entries(lines, file_label=lbl)
            sessions = assign_sessions(entries)
            selected = select_sessions(sessions, session_selector)
            all_entries.extend(selected)

        matched = [e for e in all_entries if should_include(e, state, fcfg)]

        # context expansion (per-file ordering already in all_entries; good enough)
        matched_idx = {e.index for e in matched}
        expanded = expand_with_context(all_entries, matched_idx, out_cfg.context)

        # extract just entries while keeping "is_match" marker
        expanded_entries = [e for e, _is_match in expanded]
        expanded_entries = apply_dedupe(expanded_entries, dedupe=out_cfg.dedupe, cluster_by=out_cfg.cluster_by)

        cluster_table = None
        if out_cfg.cluster:
            expanded_entries, cluster_table = apply_clustering(expanded_entries, cluster_by=out_cfg.cluster_by, occurrence=out_cfg.occurrence)

        if out_cfg.export_html:
            export_html(expanded_entries, out_cfg.export_html)

        if out_cfg.plain:
            if not out_cfg.summary_only:
                printed = 0
                for e in expanded_entries:
                    if out_cfg.max_print and printed >= out_cfg.max_print:
                        break
                    console.print(render_plain(e))
                    printed += 1
            return 0

        console.print(summary_table(expanded_entries))

        if out_cfg.top:
            for what in out_cfg.top:
                w = what.strip().lower()
                if w == "sources":
                    console.print(top_table_sources(expanded_entries))
                elif w == "exceptions":
                    console.print(top_table_exceptions(expanded_entries))
                elif w == "scoped":
                    console.print(top_table_scoped(expanded_entries))
                elif w == "messages":
                    console.print(top_table_messages(expanded_entries))
                elif w == "game":
                    console.print(top_table_game(expanded_entries))

        if cluster_table:
            console.print(cluster_table)

        if out_cfg.summary_only:
            return 0

        printed = 0
        for e in expanded_entries:
            if out_cfg.max_print and printed >= out_cfg.max_print:
                console.print(f"[dim]... truncated (printed {printed} of {len(expanded_entries)}). Use --max 0 for unlimited.[/dim]")
                break
            console.print(render_entry_panel(e, show_index=out_cfg.show_index))
            printed += 1

        if out_cfg.export_html:
            console.print(f"[green]Exported HTML[/green] -> {out_cfg.export_html}")

        return 0

    # ---- streaming (follow/live) ----
    q_lines: "queue.Queue[TailEvent]" = queue.Queue()
    stop_evt = threading.Event()

    paths = []
    labels = []
    for p in all_paths:
        if p.exists():
            paths.append(p)
            labels.append(p.name)

    if not paths:
        raise SystemExit("No log files found to follow.")

    # discovery snapshot from primary log
    discovery_lines = read_file_lines(log_path, read_last_bytes=args.read_last_bytes)
    my_ids, my_names = discover_my_mods(discovery_lines, my_ids_cli=my_ids_cli, my_names_cli=my_names_cli, my_prefixes=my_prefixes)
    tokens = build_match_tokens(my_ids, my_names)
    state = RuntimeState(my_ids=my_ids, my_names=my_names, tokens=tokens, token_patterns=compile_token_patterns(tokens, mention_mode), catalog=catalog)

    tailers = []
    for p, lbl in zip(paths, labels):
        t = Tailer(p, lbl, q_lines, stop_evt, from_start=stream_cfg.from_start)
        tailers.append(t)
        t.start()

    # buffers per file for multiline grouping
    buffers: Dict[str, List[str]] = {lbl: [] for lbl in labels}
    last_index: Dict[str, int] = {lbl: 0 for lbl in labels}
    session_id: Dict[str, int] = {lbl: 1 for lbl in labels}
    recent_before: Dict[str, Deque[SmapiEntry]] = {lbl: deque(maxlen=max(out_cfg.context, 0)) for lbl in labels}
    after_remaining: Dict[str, int] = {lbl: 0 for lbl in labels}
    dedupe_seen: Deque[str] = deque(maxlen=max(out_cfg.dedupe, 0))
    matched_window: Deque[SmapiEntry] = deque(maxlen=max(stream_cfg.window, 200))

    # live stats
    counts = Counter()
    sources = Counter()
    scoped_categories = Counter()

    key_q: "queue.Queue[str]" = queue.Queue()
    key_reader = None
    flags = LiveFlags()

    def rebuild_patterns() -> None:
        state.token_patterns = compile_token_patterns(state.tokens, fcfg.mention_mode)

    def try_dynamic_mod_discovery(entry: SmapiEntry) -> None:
        if not stream_cfg.watch_mods:
            return
        if entry.source.strip() != "SMAPI":
            return
        if not entry.lines:
            return
        line = entry.lines[0]
        mm = LOAD_MOD_RE.match(line.strip())
        if mm:
            uid = mm.group("uid").strip().rstrip(".")
            name = mm.group("name").strip().rstrip(".")
            if any(uid.startswith(p) for p in my_prefixes) and uid not in state.my_ids:
                state.my_ids.add(uid)
                state.my_names.add(name)
                state.tokens = build_match_tokens(state.my_ids, state.my_names)
                rebuild_patterns()

    def build_entry_from_buffer(file_label: str, buf: List[str]) -> SmapiEntry:
        last_index[file_label] += 1
        idx = last_index[file_label]
        head = buf[0].rstrip("\n")
        m = HEADER_RE.match(head)
        if not m:
            e = SmapiEntry(index=idx, time="??:??:??", level="INFO", source="(stream)", lines=[ln.rstrip("\n") for ln in buf], file=file_label)
        else:
            e = SmapiEntry(
                index=idx,
                time=m.group("time"),
                level=m.group("level"),
                source=m.group("source").strip(),
                lines=[m.group("msg")] + [ln.rstrip("\n") for ln in buf[1:]],
                file=file_label,
            )
        if e.lines:
            sm = SCOPED_RE.match(e.lines[0])
            if sm:
                e.scoped = ScopedInfo(
                    tag=sm.group("tag"),
                    category=sm.group("category"),
                    token=sm.group("token"),
                    message=(sm.group("rest") + ("\n" + "\n".join(e.lines[1:]) if len(e.lines) > 1 else "")).rstrip("\n"),
                )
        if is_session_start(e):
            session_id[file_label] += 1
        e.session = session_id[file_label]
        return e

    def passes_live_filters(e: SmapiEntry) -> bool:
        if flags.error_only and e.level not in {"ERROR", "ALERT"}:
            return False
        if flags.grep and flags.grep.lower() not in e.full_text_lower():
            return False
        return should_include(e, state, fcfg)

    def maybe_print_entry(e: SmapiEntry, is_match: bool, *, live: bool) -> None:
        if out_cfg.plain:
            console.print(render_plain(e))
            return
        if live:
            # live mode updates dashboard; printing panels is noisy.
            return
        panel = render_entry_panel(e, show_index=out_cfg.show_index)
        if not is_match:
            panel.border_style = "dim"
        console.print(panel)

    def handle_context_and_output(file_label: str, e: SmapiEntry, is_match: bool, *, live: bool) -> None:
        if out_cfg.context <= 0:
            maybe_print_entry(e, is_match, live=live)
            return

        if is_match:
            # print before context
            for prev in list(recent_before[file_label]):
                maybe_print_entry(prev, False, live=live)
            recent_before[file_label].clear()
            maybe_print_entry(e, True, live=live)
            after_remaining[file_label] = out_cfg.context
            return

        if after_remaining[file_label] > 0:
            maybe_print_entry(e, False, live=live)
            after_remaining[file_label] -= 1
            return

        recent_before[file_label].append(e)

    def update_live_stats(e: SmapiEntry) -> None:
        counts[e.level] += 1
        sources[e.source] += 1
        if e.scoped:
            scoped_categories[e.scoped.category] += 1

    def apply_stream_dedupe(e: SmapiEntry) -> bool:
        if out_cfg.dedupe <= 0:
            return True
        sig = signature(e, out_cfg.cluster_by)
        if sig in dedupe_seen:
            return False
        dedupe_seen.append(sig)
        return True

    def process_entry(file_label: str, e: SmapiEntry) -> None:
        try_dynamic_mod_discovery(e)

        if not passes_live_filters(e):
            handle_context_and_output(file_label, e, False, live=stream_cfg.live)
            return

        if not apply_stream_dedupe(e):
            return

        notify(e, ncfg)

        if stream_cfg.live:
            matched_window.append(e)
            update_live_stats(e)
        else:
            handle_context_and_output(file_label, e, True, live=False)

    if stream_cfg.live and stream_cfg.interactive:
        key_reader = KeyReader(key_q, stop_evt)
        key_reader.start()

    if not stream_cfg.live:
        console.print(f"[dim]Tailing {', '.join(str(p) for p in paths)} ... (Ctrl+C to stop)[/dim]")
    else:
        console.print(f"[dim]Live view: {', '.join(str(p) for p in paths)}[/dim]")

    def flush_all_buffers() -> None:
        for lbl in labels:
            buf = buffers[lbl]
            if buf:
                e = build_entry_from_buffer(lbl, buf)
                buffers[lbl] = []
                process_entry(lbl, e)

    if stream_cfg.live:
        help_shown_at = 0.0
        with Live(
            live_view(
                matched_window,
                state=state,
                counts=counts,
                sources=sources,
                scoped_categories=scoped_categories,
                window=max(5, stream_cfg.window),
                flags=flags,
            ),
            console=console,
            refresh_per_second=8,
            screen=True,
        ) as live:
            try:
                while True:
                    # handle keys
                    if stream_cfg.interactive:
                        try:
                            ch = key_q.get_nowait()
                        except queue.Empty:
                            ch = None
                        if ch is not None:
                            if flags.typing_search:
                                if ch in ("\r", "\n"):
                                    flags.grep = flags.search_buf.strip()
                                    flags.typing_search = False
                                    flags.search_buf = ""
                                elif ch == "\x1b":  # ESC
                                    flags.typing_search = False
                                    flags.search_buf = ""
                                elif ch in ("\x7f", "\b"):  # backspace
                                    flags.search_buf = flags.search_buf[:-1]
                                else:
                                    if ch.isprintable():
                                        flags.search_buf += ch
                            else:
                                if ch.lower() == "q":
                                    raise KeyboardInterrupt
                                if ch.lower() == "p":
                                    flags.paused = not flags.paused
                                if ch.lower() == "e":
                                    flags.error_only = not flags.error_only
                                if ch.lower() == "c":
                                    matched_window.clear()
                                    counts.clear()
                                    sources.clear()
                                    scoped_categories.clear()
                                if ch == "/":
                                    flags.typing_search = True
                                    flags.search_buf = ""
                                if ch.lower() == "h":
                                    help_shown_at = time.time()

                    # refresh view
                    if help_shown_at and time.time() - help_shown_at < 2.5:
                        live.update(Group(live_help_panel(), live_view(matched_window, state=state, counts=counts, sources=sources,
                                                                     scoped_categories=scoped_categories, window=max(5, stream_cfg.window), flags=flags)))
                    else:
                        live.update(
                            live_view(
                                matched_window,
                                state=state,
                                counts=counts,
                                sources=sources,
                                scoped_categories=scoped_categories,
                                window=max(5, stream_cfg.window),
                                flags=flags,
                            )
                        )

                    if flags.paused:
                        time.sleep(0.05)
                        continue

                    try:
                        ev = q_lines.get(timeout=0.05)
                    except queue.Empty:
                        continue

                    line = ev.line
                    lbl = ev.file_label

                    if HEADER_RE.match(line.rstrip("\n")):
                        if buffers[lbl]:
                            e = build_entry_from_buffer(lbl, buffers[lbl])
                            buffers[lbl] = []
                            process_entry(lbl, e)
                        buffers[lbl] = [line]
                    else:
                        buffers[lbl].append(line)

            except KeyboardInterrupt:
                stop_evt.set()
                flush_all_buffers()
                return 0

    # follow (non-live) loop
    try:
        while True:
            try:
                ev = q_lines.get(timeout=0.25)
            except queue.Empty:
                continue
            line = ev.line
            lbl = ev.file_label
            if HEADER_RE.match(line.rstrip("\n")):
                if buffers[lbl]:
                    e = build_entry_from_buffer(lbl, buffers[lbl])
                    buffers[lbl] = []
                    process_entry(lbl, e)
                buffers[lbl] = [line]
            else:
                buffers[lbl].append(line)
    except KeyboardInterrupt:
        stop_evt.set()
        flush_all_buffers()

        # optional dashboards at end
        if not out_cfg.plain:
            console.print(summary_table(list(matched_window)))
            if out_cfg.top:
                for what in out_cfg.top:
                    w = what.strip().lower()
                    if w == "sources":
                        console.print(top_table_sources(list(matched_window)))
                    elif w == "exceptions":
                        console.print(top_table_exceptions(list(matched_window)))
                    elif w == "scoped":
                        console.print(top_table_scoped(list(matched_window)))
                    elif w == "messages":
                        console.print(top_table_messages(list(matched_window)))
                    elif w == "game":
                        console.print(top_table_game(list(matched_window)))

        if out_cfg.export_html:
            export_html(list(matched_window), out_cfg.export_html)
            if not out_cfg.plain:
                console.print(f"[green]Exported HTML[/green] -> {out_cfg.export_html}")

        return 0


if __name__ == "__main__":
    raise SystemExit(main())
