# File reading (perf knobs)
# -----------------------------


def read_file_lines(path: Path, *, read_last_bytes: int = 0) -> List[str]:
    if not path.exists():
        raise SystemExit(f"Log file not found: {path}")
    if read_last_bytes and read_last_bytes > 0:
        with path.open("rb") as f:
            f.seek(0, os.SEEK_END)
            size = f.tell()
            f.seek(max(0, size - read_last_bytes), os.SEEK_SET)
            data = f.read().decode("utf-8", errors="replace")
            if size > read_last_bytes:
                nl = data.find("\n")
                if nl != -1:
                    data = data[nl + 1 :]
            return [ln + "\n" for ln in data.splitlines()]
    return path.read_text(encoding="utf-8", errors="replace").splitlines(True)


# -----------------------------
# Multi-tail + rotation
# -----------------------------


@dataclass
class TailEvent:
    file_label: str
    line: str


class Tailer(threading.Thread):
    def __init__(
        self,
        path: Path,
        file_label: str,
        out_q: "queue.Queue[TailEvent]",
        stop_evt: threading.Event,
        *,
        from_start: bool,
        poll: float = 0.25,
    ):
        super().__init__(daemon=True)
        self.path = path
        self.file_label = file_label
        self.out_q = out_q
        self.stop_evt = stop_evt
        self.from_start = from_start
        self.poll = poll

    def run(self) -> None:
        fp = None
        inode = None
        pos = 0

        while not self.stop_evt.is_set():
            try:
                st = self.path.stat()
            except FileNotFoundError:
                time.sleep(self.poll)
                continue

            rotated = inode is not None and getattr(st, "st_ino", None) != inode
            truncated = st.st_size < pos

            if fp is None or rotated or truncated:
                try:
                    if fp:
                        fp.close()
                except Exception:
                    pass

                try:
                    fp = self.path.open("r", encoding="utf-8", errors="replace")
                except Exception:
                    time.sleep(self.poll)
                    continue

                inode = getattr(st, "st_ino", None)
                if self.from_start or truncated:
                    fp.seek(0, os.SEEK_SET)
                else:
                    fp.seek(0, os.SEEK_END)
                pos = fp.tell()

            try:
                line = fp.readline()
                if line:
                    pos = fp.tell()
                    self.out_q.put(TailEvent(file_label=self.file_label, line=line))
                else:
                    time.sleep(self.poll)
            except Exception:
                time.sleep(self.poll)


# -----------------------------
# Interactive key reader (live)
# -----------------------------


class KeyReader(threading.Thread):
    def __init__(self, out_q: "queue.Queue[str]", stop_evt: threading.Event):
        super().__init__(daemon=True)
        self.out_q = out_q
        self.stop_evt = stop_evt

    def run(self) -> None:
        if os.name == "nt":
            self._run_windows()
        else:
            self._run_posix()

    def _run_windows(self) -> None:
        import msvcrt  # type: ignore

        while not self.stop_evt.is_set():
            if msvcrt.kbhit():
                ch = msvcrt.getwch()
                self.out_q.put(ch)
            else:
                time.sleep(0.05)

    def _run_posix(self) -> None:
        import select
        import termios
        import tty

        fd = sys.stdin.fileno()
        old = termios.tcgetattr(fd)
        try:
            tty.setcbreak(fd)
            while not self.stop_evt.is_set():
                r, _, _ = select.select([sys.stdin], [], [], 0.05)
                if r:
                    ch = sys.stdin.read(1)
                    self.out_q.put(ch)
        finally:
            termios.tcsetattr(fd, termios.TCSADRAIN, old)


