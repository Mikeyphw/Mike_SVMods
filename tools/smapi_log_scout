def style_message_text(text: Text) -> Text:
    for pat, style in HILITE_PATTERNS:
        try:
            text.highlight_regex(pat, style=style)
        except re.error:
            continue
    return text


def render_entry_panel(entry: SmapiEntry, *, show_index: bool) -> Panel:
    level_style = LEVEL_STYLES.get(entry.level, "")
    title = Text()
    if show_index:
        title.append(f"#{entry.index} ", style="dim")
    title.append(f"[{entry.time}] ", style="dim")
    title.append(entry.level, style=level_style)
    title.append(" ")
    title.append(entry.source, style="bold")
    title.append(" ")
    title.append(f"({entry.file}", style="dim")
    title.append(f" s{entry.session})", style="dim")

    body = entry.message()
    if entry.scoped:
        scoped_hdr = f"[{entry.scoped.tag}][{entry.scoped.category}][{entry.scoped.token}] "
        body = scoped_hdr + entry.scoped.message

    t = style_message_text(Text(body))
    return Panel(t, title=title, border_style=level_style or "dim")


def render_plain(entry: SmapiEntry) -> str:
    msg = entry.message()
    first = msg.splitlines()[0] if msg else ""
    extra = len(msg.splitlines()) - 1 if msg else 0
    if extra > 0:
        first = f"{first} (+{extra} lines)"
    return f"[{entry.time} {entry.level} {entry.source} {entry.file} s{entry.session}] {first}"


def summary_table(entries: Sequence[SmapiEntry]) -> Table:
    counts = Counter((e.level for e in entries))
    by_source = Counter((e.source for e in entries))
    by_scoped_category = Counter((e.scoped.category for e in entries if e.scoped))

    table = Table(title="Filtered entries summary", show_lines=False)
    table.add_column("Metric", style="bold")
    table.add_column("Value")

    table.add_row("Entries", str(len(entries)))

    levels_text = Text()
    for lvl in ["TRACE", "DEBUG", "INFO", "WARN", "ERROR", "ALERT"]:
        if counts[lvl]:
            levels_text.append(f"{lvl}={counts[lvl]}  ", style=LEVEL_STYLES.get(lvl, ""))
    table.add_row("By level", levels_text if levels_text else "-")

    sources_text = Text()
    for src, n in by_source.most_common(8):
        sources_text.append(f"{src}={n}  ", style="dim")
    table.add_row("Top sources", sources_text if sources_text else "-")

    cats_text = Text()
    for cat, n in by_scoped_category.most_common(8):
        cats_text.append(f"{cat}={n}  ", style="dim")
    table.add_row("Top scoped categories", cats_text if cats_text else "-")

    return table


def top_table_sources(entries: Sequence[SmapiEntry], limit: int = 15) -> Table:
    c = Counter(e.source for e in entries)
    t = Table(title="Top sources")
    t.add_column("Source", style="bold")
    t.add_column("Count", justify="right")
    for src, n in c.most_common(limit):
        t.add_row(src, str(n))
    return t


def top_table_scoped(entries: Sequence[SmapiEntry], limit: int = 15) -> Table:
    c = Counter(f"{e.scoped.tag}/{e.scoped.category}" for e in entries if e.scoped)
    t = Table(title="Top scoped tag/category")
    t.add_column("Tag/Category", style="bold")
    t.add_column("Count", justify="right")
