    args = parser.parse_args(argv)
    console = Console()

    cfg = load_toml(args.config) if args.config else {}

    # ---- merge config defaults ----
    log_path = args.log or Path(deep_get(cfg, ["general", "log"], str(DEFAULT_LOG_PATH))).expanduser()
    extra_logs = [Path(p).expanduser() for p in (deep_get(cfg, ["general", "extra_logs"], []) or [])]
