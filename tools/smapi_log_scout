def live_view(
    matched: Deque[SmapiEntry],
    *,
    state: RuntimeState,
    counts: Counter[str],
    sources: Counter[str],
    scoped_categories: Counter[str],
    window: int,
    flags: LiveFlags,
) -> Group:
    header = Text.assemble(
        ("SMAPI Log Scout", "bold"),
        ("  |  ", "dim"),
        (f"window={window}", "dim"),
        ("  |  ", "dim"),
        (f"my_ids={len(state.my_ids)}", "dim"),
        ("  ", "dim"),
        (f"my_names={len(state.my_names)}", "dim"),
    )
    status = Text()
    status.append("paused " if flags.paused else "live ", style="yellow" if flags.paused else "green")
    if flags.error_only:
        status.append("| ERROR-only ", style="bold red")
    if flags.grep:
        status.append("| grep=", style="dim")
        status.append(flags.grep, style="bold")
    if flags.typing_search:
        status.append("  /", style="dim")
        status.append(flags.search_buf, style="bold")

    summary = Table(show_header=False, box=None, pad_edge=False)
    summary.add_column("k", style="bold")
    summary.add_column("v")

    lvl_line = Text()
    for lvl in ["TRACE", "DEBUG", "INFO", "WARN", "ERROR", "ALERT"]:
        if counts[lvl]:
            lvl_line.append(f"{lvl}={counts[lvl]}  ", style=LEVEL_STYLES.get(lvl, ""))

    summary.add_row("Matched", str(sum(counts.values())))
    summary.add_row("Levels", lvl_line if lvl_line else "-")

    src_line = Text()
    for src, n in sources.most_common(6):
        src_line.append(f"{src}={n}  ", style="dim")
    summary.add_row("Sources", src_line if src_line else "-")

    cat_line = Text()
    for cat, n in scoped_categories.most_common(6):
        cat_line.append(f"{cat}={n}  ", style="dim")
    summary.add_row("Scoped cats", cat_line if cat_line else "-")

    entries_table = Table(title="Latest matched entries", show_lines=False)
    entries_table.add_column("Time", style="dim", width=8, no_wrap=True)
    entries_table.add_column("Lvl", width=5, no_wrap=True)
    entries_table.add_column("Source", style="bold", no_wrap=True)
    entries_table.add_column("File", style="dim", no_wrap=True)
    entries_table.add_column("Msg (preview)")

    for e in list(matched)[-window:]:
        preview = e.message().splitlines()[0] if e.lines else ""
        extra = (len(e.message().splitlines()) - 1) if e.lines else 0
        if extra > 0:
            preview = f"{preview}  (+{extra} lines)"
        if e.scoped:
            preview = f"[{e.scoped.tag}][{e.scoped.category}][{e.scoped.token}] {preview}"
        entries_table.add_row(
            e.time,
            Text(e.level, style=LEVEL_STYLES.get(e.level, "")),
            e.source,
            e.file,
            preview,
        )

    help_line = Text("keys: q quit | p pause | e ERROR-only | c clear | / search | Enter apply | Esc cancel | h help", style="dim")
    return Group(Panel(Group(header, status, summary), border_style="dim"), entries_table, help_line)


