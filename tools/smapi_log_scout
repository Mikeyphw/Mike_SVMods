def _notify_run_cmd(cmd: str, title: str, body: str) -> None:
    cmd = cmd.replace("{title}", title).replace("{body}", body)
    args = shlex.split(cmd)
    subprocess.Popen(args, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)  # noqa: S603,S607


def notify(entry: SmapiEntry, cfg: NotifyConfig) -> None:
    if cfg.mode == "none":
        return
    if entry.level not in cfg.levels:
        return

    title = f"SMAPI {entry.level} - {entry.source}"
    body = entry.message().splitlines()[0] if entry.lines else ""
    mode = cfg.mode

    try:
        if mode == "bell":
            sys.stdout.write("\a")
            sys.stdout.flush()
            return

        if mode == "notify-send":
            _notify_run_cmd(f'notify-send "{title}" "{body}"', title, body)
            return

        if mode == "osascript":
            # macOS notification (best-effort)
            script = f'display notification "{body}" with title "{title}"'
            _notify_run_cmd(f"osascript -e {shlex.quote(script)}", title, body)
            return

        if mode == "powershell":
            # best-effort Windows toast via PowerShell (won't always work depending on environment)
            ps = (
                "powershell -NoProfile -ExecutionPolicy Bypass -Command "
                + shlex.quote(
                    f'[Windows.UI.Notifications.ToastNotificationManager, Windows.UI.Notifications, ContentType = WindowsRuntime] > $null;'
                    f'$template = [Windows.UI.Notifications.ToastTemplateType]::ToastText02;'
                    f'$xml = [Windows.UI.Notifications.ToastNotificationManager]::GetTemplateContent($template);'
                    f'$text = $xml.GetElementsByTagName("text");'
                    f'$text.Item(0).AppendChild($xml.CreateTextNode("{title}")) > $null;'
                    f'$text.Item(1).AppendChild($xml.CreateTextNode("{body}")) > $null;'
                    f'$toast = [Windows.UI.Notifications.ToastNotification]::new($xml);'
                    f'[Windows.UI.Notifications.ToastNotificationManager]::CreateToastNotifier("SMAPILogScout").Show($toast);'
                )
            )
            _notify_run_cmd(ps, title, body)
            return

        if mode.startswith("cmd:"):
            _notify_run_cmd(mode[len("cmd:") :].strip(), title, body)
            return
    except Exception:
        return


