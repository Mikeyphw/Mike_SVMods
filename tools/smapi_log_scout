# -----------------------------
# Context / dedupe / clustering expansion
# -----------------------------


def expand_with_context(entries: List[SmapiEntry], matched_indices: Set[int], context: int) -> List[Tuple[SmapiEntry, bool]]:
    if context <= 0:
        return [(e, True) for e in entries if e.index in matched_indices]
    idx_to_pos = {e.index: i for i, e in enumerate(entries)}
    include: Set[int] = set()
    for idx in matched_indices:
        if idx not in idx_to_pos:
            continue
        p = idx_to_pos[idx]
        for q in range(max(0, p - context), min(len(entries), p + context + 1)):
            include.add(entries[q].index)
    out = []
    for e in entries:
        if e.index in include:
            out.append((e, e.index in matched_indices))
    return out


def apply_dedupe(
    entries: Iterable[SmapiEntry], *, dedupe: int, cluster_by: str
) -> List[SmapiEntry]:
    if dedupe <= 0:
        return list(entries)
    seen: Deque[str] = deque(maxlen=dedupe)
    out: List[SmapiEntry] = []
    for e in entries:
        sig = signature(e, cluster_by)
        if sig in seen:
            continue
        seen.append(sig)
        out.append(e)
    return out


def apply_clustering(
    entries: List[SmapiEntry], *, cluster_by: str, occurrence: str
) -> Tuple[List[SmapiEntry], Table]:
    groups: Dict[str, List[SmapiEntry]] = {}
    for e in entries:
        groups.setdefault(signature(e, cluster_by), []).append(e)

    t = Table(title=f"Clusters ({cluster_by})")
    t.add_column("Count", justify="right")
    t.add_column("Representative", style="bold")

    reps: List[SmapiEntry] = []
    for sig, items in sorted(groups.items(), key=lambda kv: len(kv[1]), reverse=True):
        rep = items[0] if occurrence == "first" else items[-1] if occurrence == "latest" else None
        if occurrence == "all":
            reps.extend(items)
        else:
            reps.append(rep)
        t.add_row(str(len(items)), sig[:140] + ("…" if len(sig) > 140 else ""))

    return reps, t


