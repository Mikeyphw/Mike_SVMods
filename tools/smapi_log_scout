#!/usr/bin/env python3
# tools/smapi_log_scout.py
"""
SMAPI Log Scout (Rich)

Surfaces:
  1) Your mods' logs (auto-detected via UniqueId prefixes like Mikew.* + known IDs/names).
  2) game ERROR entries.
  3) Any other entry that mentions your mods by name/UniqueId/namespace/scoped tags.

Adds:
  - since/until time filtering
  - level include/exclude
  - source include/exclude
  - scoped tag/category filters
  - highlighting
  - clustering + occurrence selection (first/latest/all)
  - rolling dedupe
  - context (before/after) around matches
  - session selection (last/all/N)
  - HTML export
  - notify hooks (bell / notify-send / osascript / powershell / cmd:...)
  - dynamic mod discovery while streaming
  - log rotation handling
  - multi-file tail (extra logs, optional crash log)
  - regex / not-regex
  - game error classification (top)
  - performance knobs (read last bytes)
  - interactive controls in --live (pause, error-only, clear, grep, help)
  - top dashboards
  - ScopedLogCatalog awareness (optional validation)
  - config file (TOML)
  - pipe-friendly output (--plain)

Examples:
  python3 tools/smapi_log_scout.py
  python3 tools/smapi_log_scout.py --session last --since 12:00:00 --level warn,error
  python3 tools/smapi_log_scout.py --top sources --top exceptions
  python3 tools/smapi_log_scout.py --cluster --occurrence latest
  python3 tools/smapi_log_scout.py --follow --context 3 --notify bell
  python3 tools/smapi_log_scout.py --live --interactive
  python3 tools/smapi_log_scout.py --export-html /tmp/mikew-smapi.html
"""

